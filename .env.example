# Required: Decodo Web Data API token.
# Dashboard: Web Data API → API Playground → "API Key".
DECODO_AUTH=

# Optional: webhook alerts (Slack or Discord). Needs --alerts on check/schedule.
ALERT_WEBHOOK_URL=

# Optional: email alerts. Every field in this block except SMTP_PORT must be
# set, or email is skipped. Uses STARTTLS (587), not implicit TLS (465).
# SMTP_PORT must not be blank.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
# One address only
ALERT_EMAIL_TO=

# Optional: overrides (defaults shown).
RANK_DB=rank_tracker.db
LOG_LEVEL=INFO